{
    "name": "pdftoolkit/pdf-reader",
    "type": "library",
    "description": "A bounded PDF object reader with password, certificate and source PDF MAC authentication for PHP 8.3+",
    "keywords": [
        "pdf",
        "pdf-1.7",
        "pdf-2.0",
        "iso-32000-1",
        "reader",
        "object-model",
        "php"
    ],
    "homepage": "https://pdftoolkit.github.io/modules/reader/",
    "support": {
        "issues": "https://github.com/PDFToolkit/pdf-reader/issues",
        "source": "https://github.com/PDFToolkit/pdf-reader",
        "docs": "https://pdftoolkit.github.io/modules/reader/"
    },
    "require": {
        "php": "^8.3",
        "ext-ctype": "*",
        "ext-zlib": "*",
        "roukmoute/pdf": "^0.9"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "ext-openssl": "Required when explicitly selecting native AES or OpenSSL certificate authentication."
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias STRASSER",
            "email": "contact@roukmoute.fr"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "PDF\\Reading\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PDF\\Reading\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@test",
            "@analyse",
            "@format:check"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.4.x-dev"
        }
    }
}
